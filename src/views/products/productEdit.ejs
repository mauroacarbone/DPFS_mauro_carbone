<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="auth admin-form">
    <h1>Editar vehículo</h1>
    <form action="/products/<%= product.id %>?_method=PUT" method="post" enctype="multipart/form-data">
      <input type="hidden" name="_method" value="PUT" />
      <div class="campo">
        <label for="name">Nombre del producto</label>
        <input id="name" name="name" type="text" value="<%= product.name %>" required />
      </div>
      <div class="campo">
        <label for="description">Descripción</label>
        <textarea id="description" name="description" rows="4" required><%= product.description %></textarea>
      </div>
      <div class="campo">
        <label for="imageFile">Nueva imagen</label>
        <input id="imageFile" name="imageFile" type="file" accept="image/*" />
      </div>
      <div class="campo">
        <label for="image">Ruta de imagen</label>
        <input id="image" name="image" type="text" value="<%= product.image %>" />
      </div>
      <div class="campo">
        <label for="productCategoryId">Categoría</label>
        <select id="productCategoryId" name="productCategoryId">
          <% productCategories.forEach(function (item) { %>
            <option value="<%= item.id %>" <%= Number(product.productCategoryId) === Number(item.id) ? 'selected' : '' %>><%= item.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label for="brandId">Marca</label>
        <select id="brandId" name="brandId">
          <% brands.forEach(function (item) { %>
            <option value="<%= item.id %>" <%= Number(product.brandId) === Number(item.id) ? 'selected' : '' %>><%= item.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label for="colorId">Color</label>
        <select id="colorId" name="colorId">
          <% colors.forEach(function (item) { %>
            <option value="<%= item.id %>" <%= Number(product.colorId) === Number(item.id) ? 'selected' : '' %>><%= item.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label for="zoneId">Zona</label>
        <select id="zoneId" name="zoneId">
          <% zones.forEach(function (item) { %>
            <option value="<%= item.id %>" <%= Number(product.zoneId) === Number(item.id) ? 'selected' : '' %>><%= item.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label for="transmission">Transmisión</label>
        <select id="transmission" name="transmission">
          <option value="Manual" <%= product.transmission === 'Manual' ? 'selected' : '' %>>Manual</option>
          <option value="Automática" <%= product.transmission === 'Automática' ? 'selected' : '' %>>Automática</option>
        </select>
      </div>
      <div class="campo">
        <label for="price">Precio</label>
        <input id="price" name="price" type="number" min="0" value="<%= product.price %>" required />
      </div>
      <p><button class="btn btn-rojo" type="submit">Guardar cambios</button></p>
    </form>
    <form action="/products/<%= product.id %>?_method=DELETE" method="post" onsubmit="return confirm('¿Eliminar este vehículo?');">
      <input type="hidden" name="_method" value="DELETE" />
      <p><button class="btn btn-linea" type="submit">Eliminar vehículo</button></p>
    </form>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
