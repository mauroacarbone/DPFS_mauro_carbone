<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="auth">
    <h1>Crear cuenta</h1>
    <p>Registrate para guardar tus reservas.</p>
    <% if (showErrors) { %>
      <div class="banner-error" role="alert">
        Revisá los datos marcados. El formulario muestra cómo se ven los errores.
      </div>
    <% } %>
    <form action="/register" method="get">
      <div class="campo">
        <label for="nombre">Nombre y apellido</label>
        <input id="nombre" name="nombre" type="text" value="Mauro Carbone" />
      </div>
      <div class="campo">
        <label for="dni">DNI</label>
        <input id="dni" name="dni" type="text" value="30111222" />
      </div>
      <div class="campo error">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="mauro@" aria-invalid="true" />
        <p class="msg-error">Ingresá un email válido, por ejemplo tu@correo.com</p>
      </div>
      <div class="campo">
        <label for="tel">Teléfono</label>
        <input id="tel" name="tel" type="tel" placeholder="11 0000-0000" />
      </div>
      <div class="campo">
        <label for="pass">Contraseña</label>
        <input id="pass" name="password" type="password" />
      </div>
      <div class="campo error">
        <label for="pass2">Repetir contraseña</label>
        <input id="pass2" type="password" aria-invalid="true" />
        <p class="msg-error">Las contraseñas no coinciden.</p>
      </div>
      <label class="check"><input type="checkbox" /> Acepto términos y política de datos</label>
      <p><button class="btn btn-rojo" type="submit">Registrarme</button></p>
    </form>
    <p>¿Ya tenés cuenta? <a href="/users/login">Ingresá</a></p>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
