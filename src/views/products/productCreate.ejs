<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="auth admin-form">
    <h1>Alta de vehículo</h1>
    <p>Los datos se guardan en products.json (Sprint 4).</p>
    <form action="/products" method="post" enctype="multipart/form-data">
      <div class="campo">
        <label for="name">Nombre del producto</label>
        <input id="name" name="name" type="text" required />
      </div>
      <div class="campo">
        <label for="description">Descripción</label>
        <textarea id="description" name="description" rows="4" required></textarea>
      </div>
      <div class="campo">
        <label for="imageFile">Imagen</label>
        <input id="imageFile" name="imageFile" type="file" accept="image/*" />
      </div>
      <div class="campo">
        <label for="image">O ruta de imagen</label>
        <input id="image" name="image" type="text" placeholder="/images/etios.jpg" />
      </div>
      <div class="campo">
        <label for="category">Categoría</label>
        <select id="category" name="category">
          <option value="Auto">Auto</option>
          <option value="Moto">Moto</option>
        </select>
      </div>
      <div class="campo">
        <label for="colors">Color</label>
        <input id="colors" name="colors" type="text" placeholder="Blanco, Gris, Rojo…" />
      </div>
      <div class="campo">
        <label for="zone">Zona</label>
        <select id="zone" name="zone">
          <option value="CABA">CABA</option>
          <option value="GBA">GBA</option>
        </select>
      </div>
      <div class="campo">
        <label for="transmission">Transmisión</label>
        <select id="transmission" name="transmission">
          <option value="Manual">Manual</option>
          <option value="Automática">Automática</option>
        </select>
      </div>
      <div class="campo">
        <label for="price">Precio</label>
        <input id="price" name="price" type="number" min="0" required />
      </div>
      <p><button class="btn btn-rojo" type="submit">Guardar vehículo</button></p>
    </form>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
