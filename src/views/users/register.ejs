<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="auth">
    <h1>Crear cuenta</h1>
    <p>Registrate para guardar tus reservas. La contraseña se guarda encriptada.</p>
    <% if (errors.email || errors.password || errors.passwordConfirm || errors.firstName || errors.lastName) { %>
      <div class="banner-error" role="alert">Revisá los datos marcados.</div>
    <% } %>
    <form action="/users/register" method="post" enctype="multipart/form-data">
      <div class="campo <%= errors.firstName ? 'error' : '' %>">
        <label for="firstName">Nombre</label>
        <input id="firstName" name="firstName" type="text" value="<%= old.firstName || '' %>" required />
        <% if (errors.firstName) { %><p class="msg-error"><%= errors.firstName %></p><% } %>
      </div>
      <div class="campo <%= errors.lastName ? 'error' : '' %>">
        <label for="lastName">Apellido</label>
        <input id="lastName" name="lastName" type="text" value="<%= old.lastName || '' %>" required />
        <% if (errors.lastName) { %><p class="msg-error"><%= errors.lastName %></p><% } %>
      </div>
      <div class="campo <%= errors.email ? 'error' : '' %>">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= old.email || '' %>" required />
        <% if (errors.email) { %><p class="msg-error"><%= errors.email %></p><% } %>
      </div>
      <div class="campo">
        <label for="category">Categoría</label>
        <select id="category" name="category">
          <option value="client" <%= old.category === 'instructor' || old.category === 'admin' ? '' : 'selected' %>>Cliente</option>
          <option value="instructor" <%= old.category === 'instructor' ? 'selected' : '' %>>Instructor</option>
          <option value="admin" <%= old.category === 'admin' ? 'selected' : '' %>>Administrador</option>
        </select>
      </div>
      <div class="campo">
        <label for="image">Foto de perfil</label>
        <input id="image" name="image" type="file" accept="image/*" />
      </div>
      <div class="campo <%= errors.password ? 'error' : '' %>">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" required />
        <% if (errors.password) { %><p class="msg-error"><%= errors.password %></p><% } %>
      </div>
      <div class="campo <%= errors.passwordConfirm ? 'error' : '' %>">
        <label for="passwordConfirm">Repetir contraseña</label>
        <input id="passwordConfirm" name="passwordConfirm" type="password" required />
        <% if (errors.passwordConfirm) { %><p class="msg-error"><%= errors.passwordConfirm %></p><% } %>
      </div>
      <p><button class="btn btn-rojo" type="submit">Registrarme</button></p>
    </form>
    <p>¿Ya tenés cuenta? <a href="/users/login">Ingresá</a></p>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
