<article class="card">
  <img src="<%= product.image %>" alt="<%= product.name %>" />
  <div class="card-body">
    <span class="tag"><%= product.category %> · <%= product.zone %> · <%= product.license %></span>
    <h3><%= product.name %></h3>
    <p class="precio">$<%= product.price.toLocaleString('es-AR') %> / turno</p>
    <a class="btn btn-rojo" href="/products/<%= product.id %>">Ver detalle</a>
  </div>
</article>
