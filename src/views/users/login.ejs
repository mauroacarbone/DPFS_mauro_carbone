<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="auth">
    <h1>Ingresar</h1>
    <p>Entrá para ver tu perfil y continuar el pago de la seña.</p>
    <% if (errors.credentials) { %>
      <div class="banner-error" role="alert"><%= errors.credentials %></div>
    <% } %>
    <form action="/users/login" method="post">
      <div class="campo <%= errors.credentials ? 'error' : '' %>">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" value="<%= old.email || '' %>" required />
      </div>
      <div class="campo">
        <label for="password">Contraseña</label>
        <input id="password" type="password" name="password" required />
      </div>
      <label class="check">
        <input type="checkbox" name="remember" value="on" />
        Recordarme en este dispositivo
      </label>
      <p><button class="btn btn-rojo" type="submit">Ingresar</button></p>
    </form>
    <p>¿No tenés cuenta? <a href="/users/register">Registrate</a></p>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
