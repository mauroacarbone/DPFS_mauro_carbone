<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="wrap seccion">
    <h1>Catálogo de vehículos habilitados</h1>
    <p>
      <% if (category) { %>Filtro: <%= category %>.<% } %>
      <% if (zone) { %> Zona: <%= zone %>.<% } %>
      <a href="/products/create">Dar de alta un vehículo</a>
    </p>
    <div class="grid-prod">
      <% if (products.length) { %>
        <% products.forEach(function (product) { %>
          <%- include('../partials/productCard', { product }) %>
        <% }) %>
      <% } else { %>
        <p>No hay resultados para esa búsqueda.</p>
      <% } %>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
